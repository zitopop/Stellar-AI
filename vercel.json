      "source": "/blog/qbcore-nil-value-error",
      "destination": "/blog/qbcore-nil-value-error/index.html"
    },
    {
      "source": "/blog/roblox-remoteevent-not-working",
      "destination": "/blog/roblox-remoteevent-not-working/index.html"
    },
    {
      "source": "/blog/qbcore-script-not-starting",
      "destination": "/blog/qbcore-script-not-starting/index.html"
    },
    {
      "source": "/api/track-event",
      "destination": "/api/get-plan?mode=track-event"
    },
    {
      "source": "/api/generate",
      "destination": "/api/chat?mode=discord-debug"
    },
    {
      "source": "/api/plugins",
      "destination": "/api/desktop-agent?surface=plugins"
    },
    {
      "source": "/api/plugin-oauth-callback",
      "destination": "/api/desktop-agent?surface=plugins&action=oauthCallback"
    }
  ],
  "redirects": [
    {
      "source": "/business-builder.html",
      "destination": "/business-builder",
      "permanent": true
    },
    {
      "source": "/mars-city",
      "destination": "/business",
      "permanent": true
    },
    {
      "source": "/robot-helpers",
      "destination": "/small-business-ai",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(), payment=()"
        }
      ]
    },
    {
      "source": "/plugins",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/roblox-studio",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/email-agent",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/deploy",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    },
    {
      "source": "/jarvis",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store"
        }
      ]
    }
  ]
}
