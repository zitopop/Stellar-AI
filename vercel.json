{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "echo Static deploy - no framework build",
  "outputDirectory": ".",
  "cleanUrls": true,
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/business",
      "destination": "/services/business"
    },
    {
      "source": "/website-audit",
      "destination": "/services/website-audit"
    },
    {
      "source": "/ai-receptionist",
      "destination": "/services/ai-receptionist"
    },
    {
      "source": "/business-builder",
      "destination": "/business-builder.html"
    },
    {
      "source": "/status",
      "destination": "/status.html"
    },
    {
      "source": "/install",
      "destination": "/install.html"
    },
    {
      "source": "/plugins",
      "destination": "/plugins.html"
    },
    {
