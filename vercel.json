    {
      "source": "/roblox-combat-system-generator",
      "destination": "/roblox-combat-system-generator/index.html"
    },
    {
      "source": "/roblox-admin-panel-generator",
      "destination": "/roblox-admin-panel-generator/index.html"
    },
    {
      "source": "/roblox-inventory-system-generator",
      "destination": "/roblox-inventory-system-generator/index.html"
    },
    {
      "source": "/fivem-housing-script-generator",
      "destination": "/fivem-housing-script-generator/index.html"
    },
    {
      "source": "/fivem-dispatch-system-script",
      "destination": "/fivem-dispatch-system-script/index.html"
    },
    {
      "source": "/fivem-crafting-script-generator",
      "destination": "/fivem-crafting-script-generator/index.html"
    },
