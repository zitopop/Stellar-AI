{
  "framework": null,
  "buildCommand": null,
  "rewrites": [
    { "source": "/app", "destination": "/app.html" },
    { "source": "/blog", "destination": "/blog.html" },
    { "source": "/blog/qbcore-police-job", "destination": "/blog.html" },
    { "source": "/blog/qbcore-drug-system", "destination": "/blog-drug-system.html" },
    { "source": "/blog/qbcore-gang-system", "destination": "/blog-gang-system.html" },
    { "source": "/blog/fivem-bank-heist-script", "destination": "/blog-bank-heist.html" },
    { "source": "/", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), geolocation=(), payment=()" }
      ]
    }
  ]
}
